# Code generated by AI (Antigravity)
# Objective: Minimal, secure multi-stage Dockerfile for packaging WebSG into a ~15MB production container on port 5107.

# Stage 1: Build static Go binary
FROM golang:1.24-alpine AS builder

WORKDIR /build

RUN apk add --no-cache ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-s -w" \
    -o websg ./cmd/websg

# Stage 2: Minimal runtime image
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata curl && \
    addgroup -S websg && adduser -S websg -G websg

WORKDIR /app

RUN mkdir -p /data /channels /modules && \
    chown -R websg:websg /app /data /channels /modules

COPY --from=builder /build/websg /app/websg

USER websg

ENV PORT=5107 \
    DATABASE_PATH=/data/websg.db \
    CHANNELS_DIR=/channels \
    MODULES_DIR=/modules \
    WEBSG_ADMIN_TOKEN=websg_admin_dev

EXPOSE 5107

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:5107/health || exit 1

VOLUME ["/data", "/channels", "/modules"]

ENTRYPOINT ["/app/websg"]
