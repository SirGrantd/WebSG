{
	"info": {
		"name": "WebSG Collection",
		"description": "Code generated by AI (Antigravity) — Objective: Complete Postman collection for testing WebSG (Webhook Stream Gateway) ingestion, SSE streaming, replay, batch ACK, stats, and hot-reload.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5107"
		},
		{
			"key": "admin_token",
			"value": "websg_admin_dev"
		},
		{
			"key": "channel_id",
			"value": "default"
		},
		{
			"key": "event_id",
			"value": ""
		},
		{
			"key": "ingest_token",
			"value": ""
		},
		{
			"key": "stream_token",
			"value": ""
		}
	],
	"item": [
		{
			"name": "1. Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/health",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"health"
					]
				},
				"description": "Verifica a saúde do servidor HTTP e a conectividade dos pools de leitura/escrita do SQLite WAL."
			}
		},
		{
			"name": "2. List Channels (Admin)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-Admin-Token",
						"value": "{{admin_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/v1/channels",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"v1",
						"channels"
					]
				},
				"description": "Lista todos os canais carregados em memória (sem expor tokens ou variáveis de ambiente sensíveis)."
			}
		},
		{
			"name": "3. Ingest Webhook (POST)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var eventId = pm.response.headers.get('X-Event-ID');",
							"if (eventId) {",
							"    pm.collectionVariables.set('event_id', eventId);",
							"    if (pm.environment && pm.environment.name) {",
							"        pm.environment.set('event_id', eventId);",
							"    }",
							"    console.log('Saved event_id:', eventId);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{ingest_token}}",
						"disabled": true,
						"description": "Habilite para canais protegidos com ingest_token ou token"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"nfe\": \"000123987\",\n  \"cnpj\": \"12345678000199\",\n  \"status\": \"autorizada\",\n  \"valor\": 3450.90\n}"
				},
				"url": {
					"raw": "{{base_url}}/v1/ingest/{{channel_id}}?event_type=nfe.autorizada",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"v1",
						"ingest",
						"{{channel_id}}"
					],
					"query": [
						{
							"key": "event_type",
							"value": "nfe.autorizada",
							"description": "Tipo do evento (alfanumérico, _, -, .)"
						}
					]
				},
				"description": "Envia um webhook para o canal informado e salva automaticamente o header X-Event-ID na variável {{event_id}}."
			}
		},
		{
			"name": "4. Stream SSE (Realtime & Replay)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "text/event-stream"
					},
					{
						"key": "Last-Event-ID",
						"value": "{{event_id}}",
						"disabled": true,
						"description": "Habilite para fazer replay de eventos após este ULID"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{stream_token}}",
						"disabled": true,
						"description": "Habilite para canais protegidos com stream_token / client_token"
					}
				],
				"url": {
					"raw": "{{base_url}}/v1/stream?channel={{channel_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"v1",
						"stream"
					],
					"query": [
						{
							"key": "channel",
							"value": "{{channel_id}}"
						},
						{
							"key": "format",
							"value": "envelope",
							"disabled": true,
							"description": "Habilite para receber envelope JSON com id, created_at, event_type e headers originais"
						},
						{
							"key": "replay",
							"value": "pending",
							"disabled": true,
							"description": "Habilite para receber todos os eventos pendentes (não confirmados) do canal"
						},
						{
							"key": "last_event_id",
							"value": "00000000000000000000000000",
							"disabled": true,
							"description": "Alternativa via query param ao header Last-Event-ID"
						}
					]
				},
				"description": "Abre o stream contínuo Server-Sent Events (SSE) com suporte a replay por Last-Event-ID, replay=pending e modo envelope."
			}
		},
		{
			"name": "5. List Events (Admin / Filter & Paginate)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-Admin-Token",
						"value": "{{admin_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/v1/events?channel={{channel_id}}&limit=10",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"v1",
						"events"
					],
					"query": [
						{
							"key": "channel",
							"value": "{{channel_id}}"
						},
						{
							"key": "limit",
							"value": "10"
						},
						{
							"key": "status",
							"value": "pending",
							"disabled": true,
							"description": "Filtrar por status: pending ou acked"
						},
						{
							"key": "event_type",
							"value": "nfe.autorizada",
							"disabled": true,
							"description": "Filtrar pelo event_type exato"
						},
						{
							"key": "after_id",
							"value": "{{event_id}}",
							"disabled": true,
							"description": "Cursor para buscar eventos com ULID maior que after_id"
						},
						{
							"key": "before_id",
							"value": "{{event_id}}",
							"disabled": true,
							"description": "Cursor para buscar eventos com ULID menor que before_id"
						}
					]
				},
				"description": "Consulta administrativa de eventos armazenados no SQLite com filtros por canal, status, event_type e cursores ULID."
			}
		},
		{
			"name": "6. Ack Event (Single)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "X-Admin-Token",
						"value": "{{admin_token}}"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{stream_token}}",
						"disabled": true,
						"description": "Alternativa para autenticar com o stream_token do canal em vez do Admin Token"
					}
				],
				"url": {
					"raw": "{{base_url}}/v1/events/{{event_id}}/ack?channel={{channel_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"v1",
						"events",
						"{{event_id}}",
						"ack"
					],
					"query": [
						{
							"key": "channel",
							"value": "{{channel_id}}"
						}
					]
				},
				"description": "Confirma o recebimento e processamento de um único evento pelo seu ID."
			}
		},
		{
			"name": "7. Ack Events (Batch)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "X-Admin-Token",
						"value": "{{admin_token}}"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{stream_token}}",
						"disabled": true,
						"description": "Alternativa para autenticar com o stream_token do canal"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"channel\": \"{{channel_id}}\",\n  \"ids\": [\n    \"{{event_id}}\"\n  ]\n}"
				},
				"url": {
					"raw": "{{base_url}}/v1/events/ack-batch",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"v1",
						"events",
						"ack-batch"
					]
				},
				"description": "Confirma múltiplos eventos de um canal em uma única requisição."
			}
		},
		{
			"name": "8. Manual Replay Event",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "X-Admin-Token",
						"value": "{{admin_token}}"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{stream_token}}",
						"disabled": true,
						"description": "Alternativa para autenticar com o stream_token do canal"
					}
				],
				"url": {
					"raw": "{{base_url}}/v1/events/{{event_id}}/replay",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"v1",
						"events",
						"{{event_id}}",
						"replay"
					]
				},
				"description": "Busca um evento específico no SQLite e o republica imediatamente para todos os clientes SSE conectados no canal."
			}
		},
		{
			"name": "9. Server & Storage Stats (Admin)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-Admin-Token",
						"value": "{{admin_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/v1/stats",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"v1",
						"stats"
					]
				},
				"description": "Retorna métricas operacionais: uptime_seconds, active_subscribers por canal, pending_events, acked_events, total_events, db_size_bytes e wal_size_bytes."
			}
		},
		{
			"name": "10. Hot-Reload Channels & JS Modules (Admin)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "X-Admin-Token",
						"value": "{{admin_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/v1/admin/reload",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"v1",
						"admin",
						"reload"
					]
				},
				"description": "Recarrega os arquivos channels/*.yaml, sincroniza os canais no SQLite e limpa o cache de scripts compilados da Engine JS sem derrubar conexões SSE ativas."
			}
		}
	]
}
